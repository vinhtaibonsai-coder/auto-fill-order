{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "node tests/security/rls-isolation.test.mjs && node tests/security/ai-gateway.test.mjs",
    "sync:ext": "node -e \"const fs=require('fs'),path=require('path');function cp(s,d){if(fs.statSync(s).isDirectory()){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(c=>cp(path.join(s,c),path.join(d,c)));}else{fs.copyFileSync(s,d);}}['manifest.json','src','frontend'].forEach(p=>cp(p,path.join('extension',p)));console.log('✅ Extension folder synced successfully!');\""
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.10",
    "supabase": "^2.111.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
